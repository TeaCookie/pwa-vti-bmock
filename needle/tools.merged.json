[
  {
    "name": "get_light_status",
    "description": "Get whether each indicator light is currently on or off.",
    "parameters": {
      "type": "object",
      "properties": {},
      "required": []
    }
  },
  {
    "name": "get_clock_time",
    "description": "Get the current time shown on the clock.",
    "parameters": {
      "type": "object",
      "properties": {},
      "required": []
    }
  },
  {
    "name": "read_logs",
    "description": "Show log entries for one log column, or for all columns.",
    "parameters": {
      "type": "object",
      "properties": {
        "column": {
          "type": "string",
          "enum": [
            "blue",
            "yellow",
            "red",
            "all"
          ],
          "description": "Which log column to read."
        },
        "limit": {
          "type": "integer",
          "description": "Maximum number of entries to return per column."
        },
        "offset": {
          "type": "integer",
          "description": "Number of entries to skip."
        }
      },
      "required": []
    }
  },
  {
    "name": "get_terminal_history",
    "description": "Show the terminal command history.",
    "parameters": {
      "type": "object",
      "properties": {
        "limit": {
          "type": "integer",
          "description": "Maximum number of entries to return, up to 100."
        },
        "offset": {
          "type": "integer",
          "description": "Number of entries to skip."
        },
        "filterType": {
          "type": "string",
          "enum": [
            "command",
            "output",
            "error",
            "info",
            "all"
          ],
          "description": "Which kind of entry to show."
        }
      },
      "required": []
    }
  },
  {
    "name": "toggle_light",
    "description": "Turn one indicator light on or off.",
    "parameters": {
      "type": "object",
      "properties": {
        "light": {
          "type": "string",
          "enum": [
            "blue-left",
            "blue-right",
            "yellow",
            "red"
          ],
          "description": "Which light to change."
        },
        "state": {
          "type": "boolean",
          "description": "true to turn the light on, false to turn it off."
        }
      },
      "required": [
        "light",
        "state"
      ]
    }
  },
  {
    "name": "set_yellow_timing",
    "description": "Set the range of the yellow light's automatic random toggle interval, in milliseconds.",
    "parameters": {
      "type": "object",
      "properties": {
        "minMs": {
          "type": "integer",
          "description": "Minimum interval in milliseconds, at least 1000."
        },
        "maxMs": {
          "type": "integer",
          "description": "Maximum interval in milliseconds, at most 60000."
        }
      },
      "required": [
        "minMs",
        "maxMs"
      ]
    }
  },
  {
    "name": "delete_log_entry",
    "description": "Delete one log entry by its ID.",
    "parameters": {
      "type": "object",
      "properties": {
        "column": {
          "type": "string",
          "enum": [
            "blue",
            "yellow",
            "red"
          ],
          "description": "Which log column the entry is in."
        },
        "id": {
          "type": "string",
          "description": "The ID of the log entry."
        }
      },
      "required": [
        "column",
        "id"
      ]
    }
  },
  {
    "name": "clear_logs",
    "description": "Delete ALL log entries in one column. Destructive.",
    "parameters": {
      "type": "object",
      "properties": {
        "column": {
          "type": "string",
          "enum": [
            "blue",
            "yellow",
            "red"
          ],
          "description": "Which log column to clear."
        }
      },
      "required": [
        "column"
      ]
    }
  },
  {
    "name": "export_logs",
    "description": "Export all log data as JSON or CSV.",
    "parameters": {
      "type": "object",
      "properties": {
        "format": {
          "type": "string",
          "enum": [
            "json",
            "csv"
          ],
          "description": "Export format."
        },
        "includeMetadata": {
          "type": "boolean",
          "description": "Include created and updated timestamps."
        }
      },
      "required": []
    }
  },
  {
    "name": "create_log_entry",
    "description": "Create a new log entry in the blue, yellow or red log column.",
    "parameters": {
      "type": "object",
      "properties": {
        "column": {
          "type": "string",
          "enum": [
            "blue",
            "yellow",
            "red"
          ],
          "description": "Which log column."
        },
        "time": {
          "type": "string",
          "description": "Time in 24-hour HH:MM format, for example 14:30. Omit for the current time."
        },
        "left": {
          "type": "boolean",
          "description": "Blue column only: left half on (true) or off (false)."
        },
        "right": {
          "type": "boolean",
          "description": "Blue column only: right half on (true) or off (false)."
        },
        "on": {
          "type": "boolean",
          "description": "Yellow column only: light on (true) or off (false)."
        },
        "transition": {
          "type": "string",
          "enum": [
            "on-to-off",
            "off-to-on"
          ],
          "description": "Red column only: state transition."
        }
      },
      "required": [
        "column"
      ]
    }
  },
  {
    "name": "update_log_entry",
    "description": "Change an existing log entry by its ID in the blue, yellow or red log column.",
    "parameters": {
      "type": "object",
      "properties": {
        "column": {
          "type": "string",
          "enum": [
            "blue",
            "yellow",
            "red"
          ],
          "description": "Which log column."
        },
        "id": {
          "type": "string",
          "description": "The ID of the log entry."
        },
        "time": {
          "type": "string",
          "description": "Time in 24-hour HH:MM format, for example 14:30. Omit for the current time."
        },
        "left": {
          "type": "boolean",
          "description": "Blue column only: left half on (true) or off (false)."
        },
        "right": {
          "type": "boolean",
          "description": "Blue column only: right half on (true) or off (false)."
        },
        "on": {
          "type": "boolean",
          "description": "Yellow column only: light on (true) or off (false)."
        },
        "transition": {
          "type": "string",
          "enum": [
            "on-to-off",
            "off-to-on"
          ],
          "description": "Red column only: state transition."
        }
      },
      "required": [
        "column",
        "id"
      ]
    }
  }
]
