      "type": "object",
      "properties": {
        "format": {
          "type": "string",
          "enum": [
            "json",
            "csv"
          ],
          "description": "Export format."
        },
        "includeMetadata": {
          "type": "boolean",
          "description": "Include created and updated timestamps."
        }
      },
      "required": []
    }
  },
  {
    "name": "import_logs",
