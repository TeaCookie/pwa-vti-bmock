    "parameters": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "The ID of the log entry."
        },
        "on": {
          "type": "boolean",
          "description": "Yellow light on or off."
        },
        "time": {
          "type": "string",
          "description": "Time in 24-hour HH:MM format, for example 14:30."
        }
      },
      "required": [
        "id"
      ]
    }
  },
  {
    "name": "update_red_log_entry",
    "description": "Change an existing red log entry by its ID.",
    "parameters": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "The ID of the log entry."
        },
        "transition": {
          "type": "string",
          "enum": [
            "on-to-off",
            "off-to-on"
          ],
          "description": "State transition."
        },
        "time": {
          "type": "string",
          "description": "Time in 24-hour HH:MM format, for example 14:30."
        }
      },
      "required": [
