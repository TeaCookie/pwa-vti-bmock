      ]
    }
  },
  {
    "name": "delete_log_entry",
    "description": "Delete one log entry by its ID.",
    "parameters": {
      "type": "object",
      "properties": {
        "column": {
          "type": "string",
          "enum": [
            "blue",
            "yellow",
            "red"
          ],
          "description": "Which log column the entry is in."
        },
        "id": {
          "type": "string",
          "description": "The ID of the log entry."
        },
        "confirm": {
          "type": "boolean",
          "description": "Confirmation flag."
        }
      },
      "required": [
        "column",
        "id"
      ]
    }
  },
  {
    "name": "clear_logs",
    "description": "Delete ALL log entries in one column. Destructive: needs confirm set to true.",
    "parameters": {
      "type": "object",
      "properties": {
        "column": {
          "type": "string",
          "enum": [
            "blue",
            "yellow",
            "red"
          ],
          "description": "Which log column to clear."
        },
        "confirm": {
          "type": "boolean",
          "description": "Must be true."
        },
        "dryRun": {
          "type": "boolean",
          "description": "Preview only, change nothing."
        }
      },
      "required": [
        "column",
        "confirm"
      ]
    }
  },
  {
    "name": "export_logs",
