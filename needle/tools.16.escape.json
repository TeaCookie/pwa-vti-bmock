    "parameters": {
      "type": "object",
      "properties": {
        "data": {
          "type": "object",
          "description": "Log data to import, with blue, yellow and red arrays."
        },
        "mode": {
          "type": "string",
          "enum": [
            "replace",
            "merge"
          ],
          "description": "Replace or merge."
        },
        "confirm": {
          "type": "boolean",
          "description": "Must be true."
        },
        "dryRun": {
          "type": "boolean",
          "description": "Preview only, change nothing."
        }
      },
      "required": [
        "data",
        "confirm"
      ]
    }
