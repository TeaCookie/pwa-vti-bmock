{
  "name": "needle-rs",
  "version": "0.3.1",
  "description": "under under 600 KB of WASM runtime for Cactus's Needle AI tool-calling models (v3, v2 and v1). Runs in the browser, Cloudflare Workers, and Node.js. No backend required.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/geekgineer/needle-rs.git"
  },
  "homepage": "https://github.com/geekgineer/needle-rs",
  "keywords": [
    "wasm",
    "webassembly",
    "ai",
    "llm",
    "tool-calling",
    "function-calling",
    "transformer",
    "rust",
    "no-backend",
    "browser-ai",
    "needle",
    "on-device",
    "edge-ai"
  ],
  "files": [
    "needle_wasm_bg.wasm",
    "needle_wasm_bg.wasm.d.ts",
    "needle_wasm.js",
    "needle_wasm.d.ts",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "module": "needle_wasm.js",
  "types": "needle_wasm.d.ts",
  "exports": {
    ".": {
      "import": "./needle_wasm.js",
      "types": "./needle_wasm.d.ts"
    }
  },
  "sideEffects": false
}
